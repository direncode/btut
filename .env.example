# BTUT Environment Configuration
# No configuration required! The API runs as built-in Next.js routes.
# Copy this file to .env only if you need to override defaults.

# Override API URL only if pointing to an external backend (optional)
# By default the app uses its own built-in Next.js API routes - no separate server needed.
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Database (Optional - for production use PostgreSQL/MongoDB)
# DATABASE_URL=postgresql://user:password@localhost:5432/btut

# Redis (Optional - for caching and sessions)
# REDIS_URL=redis://localhost:6379

# Authentication (Optional)
# SECRET_KEY=your-secret-key-here
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS (Optional - for Lambda deployment)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-west-2

# Monitoring (Optional)
# SENTRY_DSN=your-sentry-dsn

# Logging
LOG_LEVEL=info
