# Exclude Python backend services from Vercel deployment
# These are meant to run separately (ROS nodes, API server, Lambda functions)

api/
analytics/
benchmarks/
cloud/
integration/
lambda/
engine/
ros_ws/
scripts/

# Exclude Python integration scripts (but keep JSON data files for frontend)
integrations/ros/
integrations/sumo/*.py
integrations/sumo/*.cfg
integrations/sumo/*.sumocfg
integrations/sumo/*.net.xml
integrations/sumo/*.rou.xml
# Keep JSON data files
!integrations/sumo/*.json

# Exclude Python files
**/*.py
**/requirements.txt
**/pyproject.toml
**/uv.lock
**/Pipfile
**/Pipfile.lock

# Keep Next.js build outputs
!.next/
!node_modules/

# Temporary files
tmpclaude-*
