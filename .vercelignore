# Exclude Python backend services from Vercel deployment
# These are meant to run separately (ROS nodes, API server, Lambda functions)

api/
analytics/
benchmarks/
cloud/
integration/
integrations/
lambda/
engine/
ros_ws/
scripts/

# Exclude Python files
**/*.py
**/requirements.txt
**/pyproject.toml
**/uv.lock
**/Pipfile
**/Pipfile.lock

# Keep Next.js build outputs
!.next/
!node_modules/

# Temporary files
tmpclaude-*
